      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow6" bpmnElement="Flow6">
        <di:waypoint x="365" y="500" />
        <di:waypoint x="450" y="500" />
        <di:waypoint x="450" y="570" />
        <di:waypoint x="495" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow7" bpmnElement="Flow7">
        <di:waypoint x="745" y="570" />
        <di:waypoint x="955" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow8" bpmnElement="Flow8">
