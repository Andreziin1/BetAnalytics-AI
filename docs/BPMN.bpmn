      <bpmndi:BPMNShape id="Shape_search" bpmnElement="search">
        <dc:Bounds x="495.0" y="253.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_list" bpmnElement="list">
        <dc:Bounds x="955.0" y="253.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_listok" bpmnElement="listok">
        <dc:Bounds x="1050.0" y="380.0" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_show" bpmnElement="show">
        <dc:Bounds x="495.0" y="353.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_select" bpmnElement="select">
        <dc:Bounds x="115.0" y="463.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_request" bpmnElement="request">
        <dc:Bounds x="495.0" y="533.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_identify" bpmnElement="identify">
        <dc:Bounds x="955.0" y="533.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_auth" bpmnElement="auth">
        <dc:Bounds x="1050.0" y="700.0" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_error" bpmnElement="error">
        <dc:Bounds x="495.0" y="693.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_errend" bpmnElement="errend">
        <dc:Bounds x="600.0" y="830.0" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_calc" bpmnElement="calc">
        <dc:Bounds x="955.0" y="913.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_display" bpmnElement="display">
        <dc:Bounds x="495.0" y="1003.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_read" bpmnElement="read">
        <dc:Bounds x="115.0" y="1003.0" width="250" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end" bpmnElement="end">
        <dc:Bounds x="220.0" y="1150.0" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_emptyend" bpmnElement="emptyend">
        <dc:Bounds x="770" y="445" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_hasgames" bpmnElement="hasgames">
        <dc:Bounds x="600" y="445" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow0" bpmnElement="Flow0">
        <di:waypoint x="240" y="210" />
        <di:waypoint x="240" y="253" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow1" bpmnElement="Flow1">
        <di:waypoint x="365" y="290" />
        <di:waypoint x="495" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow2" bpmnElement="Flow2">
        <di:waypoint x="745" y="290" />
        <di:waypoint x="955" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow3" bpmnElement="Flow3">
        <di:waypoint x="1080" y="327" />
        <di:waypoint x="1080" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow4" bpmnElement="Flow4">
        <di:waypoint x="1050" y="410" />
        <di:waypoint x="900" y="410" />
        <di:waypoint x="900" y="390" />
        <di:waypoint x="745" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow5" bpmnElement="Flow5">
