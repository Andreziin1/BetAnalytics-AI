      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow10" bpmnElement="Flow10">
        <di:waypoint x="620" y="767" />
        <di:waypoint x="620" y="830" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow11" bpmnElement="Flow11">
        <di:waypoint x="1080" y="760" />
        <di:waypoint x="1080" y="913" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow12" bpmnElement="Flow12">
        <di:waypoint x="1080" y="987" />
        <di:waypoint x="1080" y="1040" />
        <di:waypoint x="745" y="1040" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow13" bpmnElement="Flow13">
        <di:waypoint x="495" y="1040" />
        <di:waypoint x="365" y="1040" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow14" bpmnElement="Flow14">
        <di:waypoint x="240" y="1077" />
        <di:waypoint x="240" y="1150" />
      </bpmndi:BPMNEdge>
